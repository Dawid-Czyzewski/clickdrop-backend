spring:
  application:
    name: economy-service
  datasource:
    url: jdbc:postgresql://localhost:5432/clickdrop_economy
    username: postgres
    password: CHANGE_ME
  jpa:
    hibernate:
      ddl-auto: validate
    open-in-view: false
  flyway:
    enabled: true
    locations: classpath:db/migration

app:
  auth:
    base-url: "http://localhost:8081"
    internal-api-key: change-me-to-a-long-shared-internal-key
  jwt:
    secret: change-me-to-a-long-secret-at-least-32-chars!!

server:
  port: 8082
