spring:
  application:
    name: auth-service
  datasource:
    url: jdbc:postgresql://localhost:5432/clickdrop_auth
    username: postgres
    password: CHANGE_ME
  jpa:
    hibernate:
      ddl-auto: validate
    open-in-view: false
  flyway:
    enabled: true
    locations: classpath:db/migration
  mail:
    host: localhost
    port: 587
    username: CHANGE_ME
    password: CHANGE_ME
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true
            required: true

app:
  internal-api-key: change-me-to-a-long-shared-internal-key
  jwt:
    secret: change-me-to-a-long-secret-at-least-32-chars!!
    access-expiration-ms: 864000000
    refresh-expiration-ms: 604800000
  mail:
    from: "ClickDrop <noreply@example.com>"
  frontend-base-url: "http://localhost:3000/"
  economy:
    base-url: "http://localhost:8082"

server:
  port: 8081
